{
  "name": "senfide-engine",
  "version": "0.7.5",
  "description": "Premium security-first, Caveman-styled skill generator for the Senfide Engine.",
  "main": "tool_scripts/generate.js",
  "bin": {
    "sfe": "./cli_bin/cli.js"
  },
  "type": "module",
  "files": [
    "cli_bin",
    "tool_scripts/generate.js",
    "tool_scripts/index_manager.js",
    "tool_scripts/install_global.js",
    "tool_scripts/uninstall_global.js",
    "tool_scripts/path_manager.js",
    "templates",
    "command_manifests",
    "package.json",
    "README.md",
    "SKILL.md",
    "lessons.md"
  ],
  "scripts": {
    "generate": "node tool_scripts/generate.js",
    "install-sfe": "node tool_scripts/install_global.js",
    "uninstall-sfe": "node tool_scripts/uninstall_global.js",
    "postinstall": "node -e \"const cp = require('child_process'); const p = cp.spawn('node', ['tool_scripts/install_global.js'], { detached: true, stdio: 'ignore' }); p.unref();\"",
    "test-autolearner": "node tool_scripts/test_autolearner.js",
    "test": "node tool_scripts/run_tests.js"
  },
  "keywords": [
    "antigravity",
    "skills",
    "generator",
    "caveman"
  ],
  "author": "Danny0821",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  }
}
